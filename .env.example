# Copy to .env and adjust. Only VITE_-prefixed vars are exposed to the browser.

# Base URL the app calls. Keep this as a relative path so the dev proxy (and any
# production reverse proxy) handles the API origin — never hardcode a host here.
VITE_API_BASE_URL=/api

# Dev-only: where the Vite proxy forwards /api requests. Read by vite.config.ts
# at dev/build time. It is VITE_-prefixed because Vite only exposes prefixed vars,
# but no client module references it, so it never reaches the bundle.
VITE_DEV_API_TARGET=https://localhost:7182

# Dev-only: port for the Vite server. Also read by vite.config.ts only.
# The backend's CORS policy allows only http://localhost:3000, which is why the
# proxy is used rather than calling the API cross-origin.
VITE_DEV_PORT=5173